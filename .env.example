# Copy this file to `.env` and fill in real values on the deployment machine.
# Never commit a real `.env` file or real API keys.

# ---------------------------------------------------------------------------
# LLM / VLM provider
# ---------------------------------------------------------------------------
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Optional OpenAI key. Only required if you choose OpenAI-hosted models or
# OpenAI embeddings in your deployment configuration.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=

# ---------------------------------------------------------------------------
# Agent models
# ---------------------------------------------------------------------------
AGENT_CHAT_MODEL=qwen3.6-plus
AGENT_NATURAL_ANSWER_MODEL=gpt-5.4
AGENT_NATURAL_ANSWER_EVIDENCE_ROWS=8
AGENT_MCQ_JUDGE_MODEL=qwen3.6-plus
AGENT_EMBEDDING_PROVIDER=dashscope
AGENT_EMBEDDING_MODEL=text-embedding-v3

# ---------------------------------------------------------------------------
# Video refinement models
# ---------------------------------------------------------------------------
VIDEO_VLM_MODEL=qwen3.6-plus
VIDEO_CLIP_REFINE_MODEL=qwen3.6-plus
VIDEO_APPEARANCE_MODEL=qwen3.6-plus
VIDEO_SCENE_PROFILE_MODEL=qwen3.6-plus
VIDEO_VLM_TIMEOUT_SEC=600

# ---------------------------------------------------------------------------
# Runtime and API
# ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8765
FASTAPI_MAX_UPLOAD_MB=4096

# Optional: set a default namespace for a prepared runtime database.
MEVID_RUNTIME_NAMESPACE=demo

# ---------------------------------------------------------------------------
# Retrieval feature switches
# ---------------------------------------------------------------------------
AGENT_ENABLE_RERANK=1
AGENT_RERANK_TOP_K=8
AGENT_TOP_K_PER_EVENT=20
AGENT_HYBRID_LIMIT=50
AGENT_SQL_LIMIT=80
AGENT_CANDIDATE_LIMIT=80
AGENT_SQL_USE_FTS5=1
AGENT_HYBRID_BM25_FUSED=1
AGENT_ENABLE_PARENT_PROJECTION=0
